# Copy to .env.local and fill in. See docs/google-cloud-setup.md.

# OAuth 2.0 Client ID (type: Web application). Required.
VITE_GOOGLE_CLIENT_ID=

# Browser API key restricted to the Google Picker API. Needed for "Join a family".
VITE_GOOGLE_API_KEY=

# Google Cloud project NUMBER (not the project id). Needed for "Join a family".
VITE_GOOGLE_APP_ID=

# Public URL used in invitation emails. Defaults to the current origin.
VITE_APP_URL=

# Spike only: override the OAuth scopes (space-separated) to compare drive.file
# with the full https://www.googleapis.com/auth/drive scope. Leave empty normally.
VITE_DRIVE_SCOPES=
